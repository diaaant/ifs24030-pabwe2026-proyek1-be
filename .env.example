NODE_ENV=development
PORT=8000

# Lokasi file SQLite (pakai volume persisten saat deploy)
DB_PATH=data/bengkelku.sqlite

# WAJIB diganti saat production (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Daftar origin frontend, pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000

# Kuota kendaraan per jam servis dan zona waktu bengkel
SLOT_CAPACITY=2
APP_TIMEZONE=Asia/Jakarta

# Seed otomatis saat server pertama kali jalan (database kosong)
AUTO_SEED=true
SEED_DEMO_DATA=true
ADMIN_NAME=Admin BengkelKu
ADMIN_EMAIL=admin@bengkelku.id
ADMIN_PASSWORD=Admin123!
